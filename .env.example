# Copy to .env and adjust. The Makefile exports these variables.

# Point to another Ollama server (e.g. a GPU node) instead of the local one.
# PREFECTURE_OLLAMA_URL=http://localhost:11434

# Where LLM outputs are cached for exact episode replay.
# PREFECTURE_CACHE_DIR=.cache/llm

# Ollama defaults to a small context window; match the largest num_ctx in config.yaml.
# OLLAMA_CONTEXT_LENGTH=8192
